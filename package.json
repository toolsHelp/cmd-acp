{
  "name": "cmd-acp",
  "version": "0.2.0",
  "description": "Expose Command Code (cmd) as an ACP (Agent Client Protocol) agent over stdio",
  "type": "module",
  "license": "MIT",
  "bin": {
    "cmd-acp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "tools",
    "fork/command-code",
    "doc/architecture"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node && chmod +x dist/index.js",
    "build:patcher": "bun build fork/command-code/src/bootstrap.ts --outfile tools/command-code-patch/dist/provider.mjs --target node --format esm",
    "link:fork-deps": "node tools/link-fork-deps.mjs",
    "build:all": "bun run build && bun run build:patcher && bun run link:fork-deps",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "bun-types": "^1.3.14",
    "typescript": "^5.8.0"
  }
}
